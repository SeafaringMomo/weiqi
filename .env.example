# 复制为 .env 后按需修改。所有配置项必须在 .env 中管理，代码不得硬编码。
# 服务
PORT=1358                # HTTP 端口
HOST=127.0.0.1           # 仅本机；如需局域网访问改为 0.0.0.0（应用无鉴权，请自行评估）
# 围棋
DEFAULT_BOARD_SIZE=19    # 默认棋盘路数，允许 9 / 13 / 19
KOMI=7.5                 # 贴目（中国规则数子法）
# 存储
DATA_DIR=./data          # 对局 JSON 持久化目录
LOG_LEVEL=info           # debug | info | warn | error
